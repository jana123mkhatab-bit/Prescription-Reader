# Gemini API key -- FREE via Google AI Studio's permanent free tier
# (rate-limited, no billing required). Powers:
#   - OCR (app/services/gemini_ocr.py), the PRIMARY OCR engine: Gemini
#     recognizes real medication names in ambiguous handwriting the way
#     TrOCR (a small specialist OCR model) cannot -- this is what gets
#     handwriting accuracy into the 90%+ range.
#   - Diagnosis matching + patient summaries (app/services/gemini_ai.py).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API key -- optional paid fallback OCR engine
# (app/services/vision_ocr.py), tried only if Gemini isn't configured or
# fails. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# No model file, label map, or IBM watsonx account needed -- OCR is
# pretrained (Gemini vision API primary, Claude vision API as an optional
# paid fallback, TrOCR as an offline last resort), diagnosis
# matching/summaries use Gemini, and drug matching uses the public RxNorm +
# openFDA APIs.
